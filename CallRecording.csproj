<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWinUI>true</UseWinUI>
    <ApplicationIcon>src\通用软件图片.ico</ApplicationIcon>
    <IsPackable>false</IsPackable>
    <Title>通话录音助手</Title>
    <Description>通话录音助手</Description>
    <Copyright>Shell</Copyright>
    <PackageProjectUrl>https://52shell.ltd</PackageProjectUrl>
    <RepositoryType>GitHub</RepositoryType>
    <AssemblyVersion>3.7.3</AssemblyVersion>
    <FileVersion>3.7.3</FileVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Downloader" Version="3.1.2" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.2-ci921"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0-preview.5.24306.7" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2646-prerelease" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.3"/>
    <PackageReference Include="NLog.Schema" Version="6.0.4"/>
    <PackageReference Include="RestSharp" Version="113.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.22" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\通用软件图片.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="src\通用软件图片闪动.ico" />
    <None Remove="appsettings.json"/>
    <EmbeddedResource Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Remove="bin\**"/>
    <None Remove="bin\**"/>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Views\MainWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Remove="bin\**"/>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\GlobalHook.cs" />
    <Compile Remove="bin\**"/>
  </ItemGroup>

  <ItemGroup>
    <None Remove="src\通用软件图片闪动.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="NLog.config"/>
    <EmbeddedResource Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <Import Project="..\MySharedProject\MySharedProject.projitems" Label="Shared" />

</Project>
