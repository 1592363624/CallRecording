<Window
    x:Class="CallRecording.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CallRecording.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Style="{StaticResource MaterialDesignWindow}"
    Title="{DynamicResource WindowTitle}"
    Width="1000"
    Height="650"
    Background="#F0F0F0"
    FontFamily="Microsoft YaHei"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <local:DoubleToThicknessConverter x:Key="DoubleToThicknessConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="ListBox_rz"
                 Margin="10"
                 Background="White"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"
                 ItemsSource="{Binding Logs}"
                 MouseDoubleClick="ListBox_rz_MouseDoubleClick">
            <ListBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy"
                                Executed="CopyCommand_Executed"
                                CanExecute="CopyCommand_CanExecute" />
            </ListBox.CommandBindings>
        </ListBox>


        <!--  底部信息栏  -->
        <Grid Grid.Row="1" />

        <!--  新增扩展区域  -->
        <StackPanel Grid.Row="2">
            <Expander
                ExpandDirection="Down"
                HorizontalAlignment="Stretch"
                materialDesign:ExpanderAssist.HorizontalHeaderPadding="35,2,24,2"
                Grid.Row="2"
                Margin="10,5,10,5"
                Header="大部分控件鼠标悬浮3秒有提示,正常情况是软件自动捕捉开始和结束录制,快捷键仅用于有需求的人"
                IsExpanded="True">
                <StackPanel Orientation="Vertical">
                    <TabControl>
                        <TabItem Header="信息栏">
                            <Grid x:Name="Bottom_information_bar">
                                <!--  在线状态标识  -->
                                <Ellipse
                                    x:Name="Onlineidentification"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Fill="{Binding OnlineStatusColor}"
                                    ToolTip="{Binding OnlineStatusToolTip}" />

                                <!--  文件大小和磁盘占比信息  -->
                                <StackPanel
                                    x:Name="Diskoccupancyinformation"
                                    Grid.Row="1"
                                    Width="{Binding Wt}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                    <!--  显示总容量、可用空间、已用空间、录音文件占用空间  -->
                                    <TextBlock Margin="1" Text="{Binding TotalSizeFM, StringFormat='磁盘总空间: {0} '}" />
                                    <TextBlock Margin="1"
                                               Text="{Binding AvailableFreeSpaceFM, StringFormat='磁盘可用空间: {0} '}" />
                                    <TextBlock Margin="1" Text="{Binding UsedSpaceFM, StringFormat='磁盘已用空间: {0} '}" />
                                    <TextBlock Margin="1" Text="{Binding IusedSpaceFM, StringFormat='录音文件占用空间: {0} '}" />

                                    <!--  柱状图展示四个变量的比例  -->
                                    <Grid
                                        Width="{Binding Wt}"
                                        Height="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <!--  已用空间部分  -->
                                        <Rectangle
                                            Width="{Binding UsedSpaceProportion}"
                                            HorizontalAlignment="Left"
                                            Fill="Red" />

                                        <!--  可用空间部分  -->
                                        <Rectangle
                                            Width="{Binding AvailableFreeSpaceProportion}"
                                            Margin="{Binding UsedSpaceProportion, Converter={StaticResource DoubleToThicknessConverter}}"
                                            HorizontalAlignment="Left"
                                            Fill="Green" />

                                        <!--  录音文件占用空间部分  -->
                                        <Rectangle
                                            Width="{Binding IusedSpaceProportion}"
                                            Margin="{Binding TotalUsedProportion, Converter={StaticResource DoubleToThicknessConverter}}"
                                            HorizontalAlignment="Left"
                                            Fill="Blue" />
                                    </Grid>

                                    <!--  颜色说明  -->
                                    <StackPanel Margin="5" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="5"
                                            Foreground="Red"
                                            Text="已用空间" />
                                        <TextBlock
                                            Margin="5"
                                            Foreground="Green"
                                            Text="可用空间" />
                                        <TextBlock
                                            Margin="5"
                                            Foreground="Blue"
                                            Text="录音文件占用空间" />
                                        <Button
                                            x:Name="Button_OpenAudioManager"
                                            Margin="10,0,0,0"
                                            Command="{Binding OpenAudioManagerCommand}"
                                            Content="音频管理"
                                            Visibility="Collapsed"
                                            ToolTip="管理录音文件(不建议使用该功能,未开发完成)" />
                                    </StackPanel>
                                </StackPanel>


                            </Grid>
                        </TabItem>
                        <TabItem Header="系统配置">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Orientation="Horizontal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="HotkeyTextBox"
                                                 Margin="0,0,10,0"
                                                 PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"
                                                 VerticalAlignment="Top"
                                                 ToolTip="设置快捷键用于启动或停止录制(正常情况是软件自动捕捉开始和结束录制,快捷键仅用于有需求的人)"
                                                 materialDesign:HintAssist.Hint="启停录制"
                                                 TextAlignment="Center"
                                                 AcceptsReturn="True"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                        <TextBox x:Name="EndHotkeyTextBox"
                                                 Margin="0,0,10,0"
                                                 PreviewKeyDown="EndHotkeyTextBox_PreviewKeyDown"
                                                 VerticalAlignment="Top"
                                                 ToolTip="Ctrl+END为默认的结束录制快捷键(正常情况是软件自动捕捉开始和结束录制,快捷键仅用于有需求的人)"
                                                 materialDesign:HintAssist.Hint="结束录制"
                                                 TextAlignment="Center"
                                                 AcceptsReturn="True"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                    <Button x:Name="Btn_ChooseSavePath"
                                            Margin="0,0,10,0"
                                            Command="{Binding ChooseSavePathCommand}"
                                            Content="选择保存路径"
                                            ToolTip="左键: 选择录音文件保存路径。&#10;右键: 重置为软件根目录下的默认目录(Recordings/)。"
                                            MouseRightButtonDown="Btn_ChooseSavePath_MouseRightButtonDown" />
                                    <Button Margin="0,0,10,0" Command="{Binding ClearLogsCommand}" Content="清除日志" />
                                    <Button
                                        x:Name="adm"
                                        Content="添加监控窗口"
                                        ToolTip="按住左键拖动到要监控的目标窗口上，再松开按钮即可添加（点击无效）。本软件自身的窗口会被自动忽略。"
                                        PreviewMouseLeftButtonDown="adm_MouseLeftButtonDown"
                                        PreviewMouseRightButtonDown="adm_MouseRightButtonDown"
                                        PreviewMouseLeftButtonUp="adm_MouseLeftButtonUp"
                                        PreviewMouseMove="adm_MouseMove" />

                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                        <CheckBox
                                            x:Name="kjzq"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding StartupCommand}"
                                            Content="开机自启  " />

                                        <CheckBox
                                            x:Name="ysms"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding StealthCommand}"
                                            Content="隐身模式  "
                                            ToolTip="隐身模式启用时，程序在后台运行且不显示窗口和系统托盘图标。" />

                                        <CheckBox
                                            x:Name="KeepOriginalFiles"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Command="{Binding KeepOriginalFilesCommand}"
                                            Content="保留独立录音文件  "
                                            ToolTip="启用后，混音完成的独立录音文件（麦克风和扬声器）将不会被删除" />

                                        <ComboBox
                                            x:Name="cb_AudioFormats"
                                            Margin="10,0,0,0"
                                            ItemsSource="{Binding AudioFormats}"
                                            SelectedItem="{Binding SelectedFormat}"
                                            SelectionChanged="Cb_AudioFormats_OnSelectionChanged"
                                            ToolTip="★推荐★MP3格式文件小(不过录制音频效果也已经优化的其实还不错),WAV格式无损音频(文件大)">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ComboBox
                                            x:Name="Loglvl"
                                            Margin="10,0,0,0"
                                            ItemsSource="{Binding AvailableLogLevels}"
                                            SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                                            ToolTip="写日志默认是关闭状态,主要用于有问题的时候调试">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2" x:Name="MonitorLstRoot">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,8,0,4">
                                        <TextBlock Text="监控列表"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Margin="0,0,8,0"
                                                   ToolTip="每行对应一个待监控窗口；勾选「启用大小检测」并填写宽高后，将按尺寸过滤，避免误录主窗口" />
                                        <Button Content="清空"
                                                Margin="6,0,0,0"
                                                Padding="10,2"
                                                Command="{Binding DataContext.ClearMonitoredWindowsCommand, ElementName=DataGrid_MonitoredWindows}"
                                                ToolTip="清空整个监控列表（不可撤销）" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,0,0,4"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Text="提示: 双击单元格可直接编辑。窗口进程名/类名/标题支持用 '|' 分隔多个候选值,按模糊匹配。宽高/启用检测留空则不进行尺寸校验。" />

                                    <DataGrid x:Name="DataGrid_MonitoredWindows"
                                              Grid.Row="2"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              ItemsSource="{Binding MonitoredWindows}"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              MinHeight="180"
                                              materialDesign:DataGridAssist.CellPadding="6,4"
                                              materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进程名"
                                                                Binding="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="160"
                                                                ToolTipService.ToolTip="窗口所属进程名,不含 .exe,支持 '|' 分隔多个" />
                                            <DataGridTextColumn Header="窗口类名"
                                                                Binding="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="180"
                                                                ToolTipService.ToolTip="窗口类名,支持 '|' 分隔多个" />
                                            <DataGridTextColumn Header="窗口标题"
                                                                Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="160"
                                                                ToolTipService.ToolTip="窗口标题片段,支持 '|' 分隔多个" />
                                            <DataGridTextColumn Header="宽"
                                                                Binding="{Binding Width, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                                Width="70" />
                                            <DataGridTextColumn Header="高"
                                                                Binding="{Binding Height, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                                                Width="70" />
                                            <DataGridCheckBoxColumn Header="启用大小检测"
                                                                    Binding="{Binding SizeCheckEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                                    Width="100"
                                                                    ToolTipService.ToolTip="勾选且宽高都填写后,会按客户区尺寸过滤,避免误录主窗口" />
                                            <DataGridTemplateColumn Header="操作" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="删除"
                                                                Padding="6,1"
                                                                Command="{Binding DataContext.RemoveMonitoredWindowCommand, ElementName=DataGrid_MonitoredWindows}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>

                            </Grid>
                        </TabItem>

                        <TabItem Header="系统公告">
                            <TextBlock x:Name="text_updateLog" Text="因为不强制显示更新公告了,就在这里预留个公告位置吧" />
                        </TabItem>
                        <TabItem Header="关于软件">
                            <StackPanel>
                                <TextBlock FontSize="20" Foreground="Red" Text="软件是免费且开源的(如果是购买的,去差评并退款)" />
                                <TextBlock FontSize="20" Foreground="Green">
                                    <Run Text="Star/Bug/需求-提交: " />
                                    <Hyperlink
                                        NavigateUri="https://github.com/1592363624/CallRecording/issues"
                                        RequestNavigate="Hyperlink_RequestNavigate"><!-- TextDecorations="{x:Null}" -->  <!-- 移除默认下划线 -->
                                        点我跳转
                                    </Hyperlink>
                                </TextBlock>
                                <!-- <TextBlock FontSize="20"> -->
                                <!--     <Run Text="问题反馈邮箱:" Foreground="DodgerBlue" /> -->
                                <!--     <Hyperlink NavigateUri="mailto:1592363624@qq.com" -->
                                <!--                RequestNavigate="Hyperlink_RequestNavigate"> -->
                                <!--         1592363624@qq.com -->
                                <!--     </Hyperlink> -->
                                <!-- </TextBlock> -->
                                <TextBlock FontSize="20" Foreground="Red" Text="软件是免费且开源的(如果是购买的,去差评并退款)" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="14"
                                               Text="更新模块：" />
                                    <ComboBox x:Name="Cb_UpdateModule"
                                              Width="160"
                                              Margin="6,0,0,0"
                                              SelectionChanged="Cb_UpdateModule_OnSelectionChanged"
                                              ToolTip="GitHub：新模块，比对 GitHub Releases，有新版本时弹出通知并跳转。&#10;Legacy：旧模块，使用 52shell 后端，含自动下载安装。">
                                        <ComboBoxItem Content="GitHub（新模块）" />
                                        <ComboBoxItem Content="Legacy（旧模块）" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Expander>
        </StackPanel>

        <Canvas Grid.Row="0" x:Name="DragFeedbackLayer" IsHitTestVisible="False" />

        <!-- 测试 -->
        <StackPanel Grid.Row="0" Visibility="Hidden">
            <Expander
                HorizontalAlignment="Stretch"
                materialDesign:ExpanderAssist.HorizontalHeaderPadding="35,2,24,2"
                Header="">
                <StackPanel
                    Margin="24,8,24,16"
                    Orientation="Vertical"
                    TextBlock.Foreground="{DynamicResource MaterialDesignBody}">
                </StackPanel>
            </Expander>
        </StackPanel>
        <!-- 测试 -->
    </Grid>
</Window>